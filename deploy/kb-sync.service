[Unit]
Description=Rust customer knowledge Feishu synchronizer
After=network-online.target kb-api.service
Wants=network-online.target kb-api.service
ConditionPathExists=/etc/rust-knowledge/sync.env

[Service]
Type=simple
User=rust-knowledge
Group=rust-knowledge
WorkingDirectory=/var/lib/rust-knowledge
EnvironmentFile=/etc/rust-knowledge/sync.env
ExecStart=/opt/rust-knowledge/current/kb-sync watch
Restart=on-failure
RestartSec=15
TimeoutStopSec=20
Nice=10
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/rust-knowledge

[Install]
WantedBy=multi-user.target
