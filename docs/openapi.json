{
  "openapi": "3.1.0",
  "info": {
    "title": "Rust 客服知识库 API",
    "version": "0.2.1",
    "description": "默认扫码入口打开飞书原表，原表访问权限由飞书决定。配置网页授权后另可按个人会话实时读取知识表。业务后端用店铺密钥查询本机已发布索引。"
  },
  "servers": [
    {
      "url": "https://kb.example.com",
      "description": "示例域名。集成时替换为实际部署的 HTTPS 源，个人网页登录需要 HTTPS。"
    },
    {
      "url": "http://127.0.0.1:8080",
      "description": "本机开发；公网集成时替换为实际 HTTPS 域名"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "operationId": "home",
        "summary": "打开个人工作台或用团队书签进入原表",
        "security": [
          {},
          {
            "PersonalSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "登录说明或当前用户的工作台。",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "303": {
            "description": "与服务器配置匹配的团队书签跳转至飞书原表。",
            "headers": {
              "Location": { "schema": { "type": "string", "format": "uri" } }
            }
          },
          "400": {
            "description": "参数无效。",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "访客须登录或重新取得飞书授权。",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "description": "飞书拒绝此用户或应用访问。",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "目标知识表不可用。",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "429": {
            "description": "飞书限流。",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "502": {
            "description": "飞书读取失败。",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "503": {
            "description": "尚未配置目标知识库。",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "504": {
            "description": "飞书请求超时。",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "base",
            "description": "团队书签中的原表标识，适用于原生扫码入口。",
            "required": false,
            "schema": { "type": "string" }
          },
          {
            "in": "query",
            "name": "table",
            "description": "可见知识表 ID。",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "by",
            "description": "筛选方式，格式为 运算符:字段名，与 value 配合使用。",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "value",
            "description": "筛选值。",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "description": "工作台下一页游标。",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/v1/admin/catalog/tables": {
      "get": {
        "operationId": "listSourceTables",
        "summary": "内部查询全量来源表、列名和记录数",
        "security": [{"AdminBearer": []}],
        "responses": {"200": {"description": "表清单。"}, "401": {"description": "缺少管理员鉴权。"}, "503": {"description": "目录尚待部署。"}}
      }
    },
    "/v1/admin/catalog/rows": {
      "get": {
        "operationId": "readSourceRows",
        "summary": "内部按表、关键词或游标读取原始知识记录",
        "security": [{"AdminBearer": []}],
        "parameters": [
          {"name":"table","in":"query","schema":{"type":"string"}},
          {"name":"q","in":"query","schema":{"type":"string"}},
          {"name":"after","in":"query","schema":{"type":"integer","minimum":0}},
          {"name":"limit","in":"query","schema":{"type":"integer","minimum":1,"maximum":25,"default":10}}
        ],
        "responses": {"200": {"description": "包含来源、原始值、停用标记和分页游标的结果。"}, "400": {"description":"筛选条件无效。"}, "401": {"description":"缺少管理员鉴权。"}, "503":{"description":"目录尚待部署。"}}
      }
    },
    "/auth/feishu/login": {
      "get": {
        "operationId": "startPersonalLogin",
        "summary": "进入飞书云文档或已配置的网页授权流程",
        "security": [],
        "responses": {
          "303": {
            "description": "默认进入飞书原生云文档；启用站内 OAuth 时进入授权页并设置浏览器临时 Cookie。",
            "headers": {
              "Location": {
                "description": "浏览器跳转地址。",
                "schema": {
                  "type": "string"
                }
              },
              "Set-Cookie": {
                "description": "浏览器接收或清除 Secure、HttpOnly、SameSite=Lax 的站点 Cookie。",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "429": {
            "description": "登录请求过多。",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "503": {
            "description": "网页登录不可用。",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/auth/feishu/callback": {
      "get": {
        "operationId": "finishPersonalLogin",
        "summary": "处理飞书授权回调",
        "security": [
          {
            "PendingLogin": []
          }
        ],
        "responses": {
          "303": {
            "description": "签发个人会话并跳回本站首页 /。",
            "headers": {
              "Location": {
                "description": "浏览器跳转地址。",
                "schema": {
                  "type": "string"
                }
              },
              "Set-Cookie": {
                "description": "浏览器接收或清除 Secure、HttpOnly、SameSite=Lax 的站点 Cookie。",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "回调无效、已过期或与浏览器不匹配。",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "description": "授权已取消。",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "429": {
            "description": "登录服务繁忙。",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "502": {
            "description": "与飞书交换令牌失败。",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "503": {
            "description": "个人登录不可用。",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "state",
            "description": "飞书原样返回的一次性 state。",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "code",
            "description": "用户允许时由飞书提供的一次性授权码。",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "error",
            "description": "用户拒绝时由飞书提供的错误。",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "endPersonalSession",
        "summary": "退出本站个人会话",
        "security": [
          {},
          {
            "PersonalSession": []
          }
        ],
        "responses": {
          "303": {
            "description": "清除站点登录和授权流程 Cookie，并返回 /。",
            "headers": {
              "Location": {
                "description": "浏览器跳转地址。",
                "schema": {
                  "type": "string"
                }
              },
              "Set-Cookie": {
                "description": "浏览器接收或清除 Secure、HttpOnly、SameSite=Lax 的站点 Cookie。",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "description": "Origin 缺少或与本站不匹配。",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "503": {
            "description": "个人登录不可用。",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "Origin",
            "description": "浏览器传送的本站 HTTPS 源，应与 KB_PUBLIC_ORIGIN 相同。",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/me/tables": {
      "get": {
        "operationId": "listPersonalTables",
        "summary": "列出本人可见的知识表",
        "security": [
          {
            "PersonalSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "仅返回本人当前可见的数据。",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "tables": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/PersonalTable"
                      }
                    }
                  },
                  "required": [
                    "tables"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "访客须登录或重新取得飞书授权。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "飞书拒绝此用户或应用访问。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "飞书限流。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "飞书读取失败。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "尚未配置目标知识库。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "504": {
            "description": "飞书请求超时。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/me/fields": {
      "get": {
        "operationId": "listPersonalFields",
        "summary": "获取本人可见的表字段和筛选运算符",
        "security": [
          {
            "PersonalSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "仅返回本人当前可见的数据。",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "fields": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/PersonalField"
                      }
                    }
                  },
                  "required": [
                    "fields"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "参数无效。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "访客须登录或重新取得飞书授权。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "飞书拒绝此用户或应用访问。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "目标知识表不可用。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "飞书限流。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "飞书读取失败。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "尚未配置目标知识库。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "504": {
            "description": "飞书请求超时。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "table_id",
            "description": "从 /me/tables 取得目标表 ID。",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 128
            }
          }
        ]
      }
    },
    "/me/records": {
      "get": {
        "operationId": "listPersonalRecords",
        "summary": "浏览或按一个字段筛选当前用户可见的飞书记录",
        "security": [
          {
            "PersonalSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "仅返回本人当前可见的数据。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PersonalRecordPage"
                }
              }
            }
          },
          "400": {
            "description": "参数无效。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "访客须登录或重新取得飞书授权。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "飞书拒绝此用户或应用访问。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "目标知识表不可用。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "飞书限流。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "飞书读取失败。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "尚未配置目标知识库。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "504": {
            "description": "飞书请求超时。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "table_id",
            "description": "从 /me/tables 取得目标表 ID。",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 128
            }
          },
          {
            "in": "query",
            "name": "field",
            "description": "筛选字段的完整名称，与 value 同时指定。最多 1024 UTF-8 字节。",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "value",
            "description": "筛选值，与 field 同时指定。最多 2048 UTF-8 字节。",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "op",
            "description": "仅用于筛选，根据 /me/fields 的 operators 选择，默认精确匹配。",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "is",
                "contains"
              ],
              "default": "is"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "description": "每页最多返回多少条记录。",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 25,
              "default": 10
            }
          },
          {
            "in": "query",
            "name": "page_token",
            "description": "上一页返回的非空 next_page_token。最多 2048 UTF-8 字节。",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/healthz": {
      "get": {
        "operationId": "health",
        "summary": "获取进程状态与已发布版本",
        "security": [],
        "responses": {
          "200": {
            "description": "成功。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/v1/sku": {
      "get": {
        "operationId": "lookupSku",
        "summary": "精确查询当前商品 SKU 或机型",
        "description": "sku、model 均省略时返回最多 100 条已启用卡片；两者同时提供时必须同时匹配。未命中返回 200 和空数组。",
        "security": [
          {
            "ShopBearer": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ProductId"
          },
          {
            "name": "sku",
            "in": "query",
            "description": "SKU 原文。省略或空串表示不限。",
            "required": false,
            "schema": {
              "type": "string",
              "description": "最多 256 UTF-8 字节。",
              "maxLength": 256
            }
          },
          {
            "name": "model",
            "in": "query",
            "description": "适用机型。省略或空串表示不限。",
            "required": false,
            "schema": {
              "type": "string",
              "description": "最多 256 UTF-8 字节。",
              "maxLength": 256
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Matches"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Bad"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/v1/search": {
      "get": {
        "operationId": "searchAnswers",
        "summary": "检索本商品及本店通用的有效话术",
        "security": [
          {
            "ShopBearer": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ProductId"
          },
          {
            "name": "q",
            "in": "query",
            "description": "搜索词或客服问句。",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/QueryText"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "最大返回条数。",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "default": 5
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Matches"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Bad"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/v1/compare": {
      "post": {
        "operationId": "compareProducts",
        "summary": "用已授权商品资料发起 AI 流式比较",
        "security": [
          {
            "ShopBearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Comparison"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "服务器发送事件流，事件依次为 sources、零个或多个 delta、done。流中途失败以 error 结束；此时 HTTP 状态仍为 200。",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                },
                "example": "event: sources\ndata: {\"version\":7,\"products\":[{\"product_id\":\"001\",\"records\":[{\"id\":\"sku:001\",\"sku\":\"A0\",\"model\":\"Example 0\",\"question\":\"\",\"answer\":\"支持无线充电\",\"source\":\"商品规格表\"}],\"more_cards\":false},{\"product_id\":\"002\",\"records\":[{\"id\":\"sku:002\",\"sku\":\"A1\",\"model\":\"Example 1\",\"question\":\"\",\"answer\":\"支持无线充电\",\"source\":\"商品规格表\"}],\"more_cards\":false}]}\n\nevent: delta\ndata: {\"text\":\"两款都支持无线充电。\"}\n\nevent: done\ndata: {\"version\":7}\n\n"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Bad"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "413": {
            "$ref": "#/components/responses/TooLarge"
          },
          "415": {
            "$ref": "#/components/responses/Unsupported"
          },
          "422": {
            "$ref": "#/components/responses/Invalid"
          },
          "429": {
            "$ref": "#/components/responses/TooMany"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/v1/admin/changes": {
      "post": {
        "operationId": "publishChanges",
        "summary": "内部同步发布一批新增、更新或删除",
        "description": "一批事务发布。内容一致的重复请求不提升知识版本。",
        "security": [
          {
            "AdminBearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Batch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionResult"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Bad"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "413": {
            "$ref": "#/components/responses/TooLarge"
          },
          "415": {
            "$ref": "#/components/responses/Unsupported"
          },
          "422": {
            "$ref": "#/components/responses/Invalid"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ShopBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "店铺业务后端持有的自选密钥，原值通过 Authorization 请求头发送。"
      },
      "AdminBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "仅供内部同步服务使用的 KB_ADMIN_TOKEN，与所有店铺密钥独立。"
      },
      "PersonalSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-kb_session",
        "description": "个人网页短期会话，由本站 OAuth 回调签发。使用同源浏览器，飞书令牌保存在服务端内存。"
      },
      "PendingLogin": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-kb_oauth",
        "description": "登录开始时签发，绑定本次登录的浏览器与一次性 state。"
      }
    },
    "parameters": {
      "ProductId": {
        "name": "product_id",
        "in": "query",
        "description": "当前会话的商品 ID。保留原始字符串和前导零。",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/QueryText"
        }
      }
    },
    "schemas": {
      "Version": {
        "type": "integer",
        "format": "int64",
        "minimum": 0
      },
      "VersionResult": {
        "type": "object",
        "properties": {
          "version": {
            "$ref": "#/components/schemas/Version"
          }
        },
        "required": [
          "version"
        ]
      },
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          },
          "version": {
            "$ref": "#/components/schemas/Version"
          }
        },
        "required": [
          "status",
          "version"
        ]
      },
      "QueryText": {
        "type": "string",
        "description": "1 至 256 UTF-8 字节；不得有首尾空白或控制字符。",
        "minLength": 1,
        "maxLength": 256
      },
      "RecordId": {
        "type": "string",
        "description": "1 至 2048 UTF-8 字节；保留前导零。",
        "minLength": 1,
        "maxLength": 2048
      },
      "Match": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "记录标识"
          },
          "sku": {
            "type": "string",
            "description": "SKU 原文，可为空"
          },
          "model": {
            "type": "string",
            "description": "适用机型，可为空"
          },
          "question": {
            "type": "string",
            "description": "问题原文，可为空"
          },
          "answer": {
            "type": "string",
            "description": "已发布答案或参数，可为空"
          },
          "source": {
            "type": "string",
            "description": "运营发布的出处文字或链接，可为空"
          }
        },
        "required": [
          "id",
          "sku",
          "model",
          "question",
          "answer",
          "source"
        ]
      },
      "Matches": {
        "type": "object",
        "properties": {
          "version": {
            "$ref": "#/components/schemas/Version"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Match"
            }
          }
        },
        "required": [
          "version",
          "items"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "稳定的机器错误码"
          }
        },
        "required": [
          "error"
        ]
      },
      "Comparison": {
        "type": "object",
        "properties": {
          "left_product_id": {
            "$ref": "#/components/schemas/QueryText"
          },
          "right_product_id": {
            "$ref": "#/components/schemas/QueryText"
          },
          "question": {
            "$ref": "#/components/schemas/QueryText"
          }
        },
        "required": [
          "left_product_id",
          "right_product_id",
          "question"
        ],
        "additionalProperties": false,
        "description": "两个商品 ID 须不同。请求体最大 8192 字节。"
      },
      "Item": {
        "type": "object",
        "properties": {
          "shop": {
            "$ref": "#/components/schemas/RecordId"
          },
          "id": {
            "$ref": "#/components/schemas/RecordId"
          },
          "kind": {
            "enum": [
              "sku",
              "answer"
            ],
            "type": "string"
          },
          "scope": {
            "enum": [
              "product",
              "shop"
            ],
            "type": "string"
          },
          "product_ids": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RecordId"
            },
            "default": []
          },
          "sku": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "answer": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          }
        },
        "required": [
          "shop",
          "id",
          "kind",
          "scope",
          "enabled"
        ],
        "description": "product 范围必须至少有一个商品 ID。shop 范围只用于 answer，且 product_ids 必须为空。缺省文本字段按空串处理。"
      },
      "Change": {
        "type": "object",
        "properties": {
          "shop": {
            "$ref": "#/components/schemas/RecordId"
          },
          "id": {
            "$ref": "#/components/schemas/RecordId"
          },
          "item": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Item"
              },
              {
                "type": "null"
              }
            ],
            "description": "更新时身份须等于外层 shop、id；显式 null 表示删除。"
          }
        },
        "required": [
          "shop",
          "id",
          "item"
        ]
      },
      "Batch": {
        "type": "object",
        "properties": {
          "changes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Change"
            },
            "maxItems": 50000
          }
        },
        "required": [
          "changes"
        ],
        "additionalProperties": false,
        "description": "一个请求最多 32 MiB。一个批次内相同 (shop,id) 以最后一次变更为准。"
      },
      "PersonalTable": {
        "type": "object",
        "properties": {
          "table_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "table_id",
          "name"
        ]
      },
      "PersonalField": {
        "type": "object",
        "properties": {
          "field_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "integer"
          },
          "operators": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "is",
                "contains"
              ]
            }
          }
        },
        "required": [
          "field_id",
          "name",
          "type",
          "operators"
        ]
      },
      "PersonalRecord": {
        "type": "object",
        "properties": {
          "record_id": {
            "type": "string"
          },
          "fields": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "每个键是本次返回的可见字段名，值是用于展示的文本。"
          },
          "source": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri",
            "description": "配置有效的 FEISHU_BASE_ORIGIN 后返回飞书原记录链接，由飞书依本人权限控制编辑。未配置有效租户源时为 null。"
          }
        },
        "required": [
          "record_id",
          "fields",
          "source"
        ]
      },
      "PersonalRecordPage": {
        "type": "object",
        "properties": {
          "records": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PersonalRecord"
            }
          },
          "has_more": {
            "type": "boolean"
          },
          "next_page_token": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "records",
          "has_more",
          "next_page_token"
        ]
      }
    },
    "responses": {
      "Bad": {
        "description": "参数或 JSON 无效。",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          },
          "text/plain": {
            "schema": {
              "type": "string"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "缺少凭据、凭据错误或密钥类型与操作不符。",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Unavailable": {
        "description": "服务繁忙，或可选的 AI 服务未启用。",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Internal": {
        "description": "内部错误。",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "某款商品没有可访问的已启用 SKU 资料。",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Conflict": {
        "description": "读取时已发布新版本，重新发起请求。",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "TooLarge": {
        "description": "请求体或批次数量超出限制。",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          },
          "text/plain": {
            "schema": {
              "type": "string"
            }
          }
        }
      },
      "Unsupported": {
        "description": "需使用 Content-Type: application/json。",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          },
          "text/plain": {
            "schema": {
              "type": "string"
            }
          }
        }
      },
      "Invalid": {
        "description": "无法解析字段或变更未能发布。",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          },
          "text/plain": {
            "schema": {
              "type": "string"
            }
          }
        }
      },
      "TooMany": {
        "description": "AI 当前并发已满。",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  }
}
